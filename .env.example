# Copy to .env and fill in. The values below are FAKE.
# .env is ignored by git: never commit it and never paste it into a chat.

# false (default): Demo mode, nothing is stored and writes return 403. No database needed.
# true: Personal mode, resumes and vacancies are saved to the database (DATABASE_URL required).
ALLOW_WRITES=false

# Neon PostgreSQL connection string (Personal mode). Use the main branch for your own data.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: a Neon "dev" branch with fake data, used only by the PostgreSQL store tests.
# When it is not set, those tests are skipped.
TEST_DATABASE_URL=postgresql://user:password@host/dbname_dev?sslmode=require

# Port of the API server in development (PORT is used first on hosting).
API_PORT=3001
