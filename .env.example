# Copy to .env and fill in only what you need.
# .env is ignored by git: never commit it and never paste it into a chat.
# The connection strings stay empty here on purpose: an empty value counts as not set,
# so a copied file starts in Demo mode without storage. The examples in the comments are FAKE.
#
# Read by the API scripts dev, start, db:migrate and db:seed. The unit tests and the
# E2E servers never read this file (the database tests take only TEST_DATABASE_URL from it).
#
# Ports are shell variables, not .env variables, because Vite and Playwright read only the shell:
#   PowerShell: $env:API_PORT=4001; $env:WEB_PORT=5174; npm run dev
#   bash:       API_PORT=4001 WEB_PORT=5174 npm run dev

# Writes are enabled only when this is exactly "true" (Personal mode, DATABASE_URL required).
# Any other value: Demo mode, writes return 403.
ALLOW_WRITES=false

# Neon PostgreSQL connection string. Without it there is no storage (Demo mode without
# the Resumes and Vacancies tabs). Personal mode: the "main" branch for your own data or
# "dev" for fake data. Public demo (set on the hosting, not here): the "demo" branch with
# the SELECT-only role demo_reader, so the deployment can never write.
# Example: postgresql://user:password@ep-example-000000.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A separate Neon "test" branch, used only by the database tests.
# The tests clean its tables, so never point it at your own data or at your "dev" branch.
# When it is empty, those tests are skipped (and reported as skipped).
# Example: postgresql://user:password@ep-example-111111.eu-central-1.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=

# The Neon "demo" branch with its owner role, used only by `npm run db:seed`,
# which replaces its contents with the records of data/seed.json.
# Example: postgresql://user:password@ep-example-222222.eu-central-1.aws.neon.tech/neondb?sslmode=require
DEMO_DATABASE_URL=
